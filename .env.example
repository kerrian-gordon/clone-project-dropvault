PORT=3000
# Free-tier bytes per account; the local demo tier is 10 times this value.
DROPVAULT_STORAGE_LIMIT_BYTES=1073741824
# Optional: folder for local uploads and metadata
# DROPVAULT_STORAGE_DIR=C:\path\to\dropvault-data
# Optional: set a private random token to claim files from a pre-account catalog.
# DROPVAULT_LEGACY_CLAIM_TOKEN=replace-with-at-least-32-random-characters
# Optional: externally reachable origin for absolute share links.
# DROPVAULT_PUBLIC_BASE_URL=https://files.example.com
# Optional: bind to a local network interface; default is 127.0.0.1.
# DROPVAULT_HOST=0.0.0.0
